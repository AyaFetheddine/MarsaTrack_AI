# --- Modele Vision ---------------------------------------------------------
VISION_MODEL_VERSION=v2
VISION_V1_MODEL_PATH=models/container_code_yolo11n_best.pt
VISION_V2_MODEL_PATH=models/container_code_type_yolo11n_v2_best.pt
VISION_MODEL_FALLBACK_TO_V1=true
# Chemin legacy (repli de defaut pour la V1).
VISION_MODEL_PATH=models/container_code_yolo11n_best.pt

VISION_DEVICE=cpu
VISION_YOLO_CONFIDENCE=0.25
VISION_YOLO_IOU=0.45

# --- Recadrage -------------------------------------------------------------
# Marge uniforme (cas horizontal, comportement d'origine).
VISION_CROP_MARGIN_PERCENT=0.04
VISION_CROP_CONTEXT_HORIZONTAL_FACTOR=1.25
VISION_CROP_CONTEXT_VERTICAL_FACTOR=0.75

# --- Lecture verticale -----------------------------------------------------
# Une zone est verticale quand hauteur/largeur >= ce seuil.
VISION_VERTICAL_RATIO_THRESHOLD=1.6
# Marges dediees aux colonnes verticales : larges en X, tres serrees en Y.
VISION_VERTICAL_CROP_MARGIN_X_PERCENT=0.30
VISION_VERTICAL_CROP_MARGIN_Y_PERCENT=0.02
# Crop contextuel (dernier recours) en pourcentage de la boite.
VISION_CONTEXT_CROP_MARGIN_PERCENT=0.60
# Agrandissement adaptatif : petit cote minimal vise, et plafond de facteur.
VISION_MIN_CROP_SIDE_PX=160
# Plafond du grand cote apres agrandissement (perf : evite les images geantes).
VISION_MAX_CROP_SIDE_PX=1100
VISION_MAX_UPSCALE_FACTOR=8
# Garde-fou de performance : variantes OCR maximum par zone.
VISION_MAX_OCR_VARIANTS=14

# --- OCR -------------------------------------------------------------------
VISION_OCR_ENABLED=true
VISION_OCR_ENGINE=paddleocr
# Résultat simulé si le modèle est indisponible : désactivé par défaut
# (mieux vaut une erreur claire qu'un faux matricule préremplissable).
VISION_FALLBACK_ENABLED=false
VISION_MAX_IMAGE_SIZE_MB=5

# --- Diagnostic local (desactive par defaut) -------------------------------
# Sauvegarde les crops, variantes et une trace JSON dans un dossier local
# ignore par Git. A n'activer que pour investiguer un cas precis.
VISION_DEBUG_SAVE_CROPS=false
VISION_DEBUG_OUTPUT_DIR=debug
