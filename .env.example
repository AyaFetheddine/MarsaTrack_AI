# =============================================================================
# Variables lues par docker-compose.yml (stack MarsaTrack complet en conteneurs)
# -----------------------------------------------------------------------------
# Copier ce fichier en .env À LA RACINE de MarsaTrack_AI :
#     cp .env.example .env
# puis renseigner au minimum JWT_SECRET (secret long et aléatoire, obligatoire :
# le backend refuse de démarrer sans).
#
# Ce fichier ne concerne QUE l'exécution via Docker Compose. Le mode natif
# (npm/uvicorn) utilise backend/.env et vision-service/.env séparément.
# =============================================================================

# Base de données
DB_NAME=marsatrack_db
DB_USER=marsatrack
DB_PASSWORD=change_me_db_password
DB_ROOT_PASSWORD=change_me_root_password

# Sécurité JWT (OBLIGATOIRE). Générer par ex. :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# IMPORTANT : valeur IDENTIQUE dans les quatre fichiers d'environnement
# des deux depots (Docker et natif). Le portail transmet son jeton a la
# console MarsaBot encadree, qui doit pouvoir le verifier.
JWT_SECRET=
