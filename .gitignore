# =============================================================================
# MarsaTrack_AI — .gitignore
# Full-Stack Node.js + React
# =============================================================================


# -----------------------------------------------------------------------------
# Fichiers d'environnement & secrets
# Ne jamais versionner les clés API, mots de passe, tokens, certificats
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx


# -----------------------------------------------------------------------------
# Dépendances Node.js
# Installées via `npm install` ou `yarn install`, inutile de les versionner
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# NE PAS ignorer package-lock.json — il garantit des builds reproductibles
# en CI/CD (GitHub Actions, Docker) et évite le "ça marche sur ma machine"
# Décommenter la ligne suivante si tu utilises Yarn à la place de npm
# yarn.lock


# -----------------------------------------------------------------------------
# Builds du frontend (React / Vite)
# Générés via `npm run build`, ne font pas partie du code source
# -----------------------------------------------------------------------------
/frontend/dist/
/frontend/build/
/frontend/.cache/


# -----------------------------------------------------------------------------
# Uploads locaux (backend)
# Contient les photos de conteneurs uploadées pendant les tests — ne jamais
# pousser des fichiers binaires/images sur GitHub
# -----------------------------------------------------------------------------
/backend/uploads/containers/*
!/backend/uploads/containers/.gitkeep


# -----------------------------------------------------------------------------
# Logs applicatifs
# -----------------------------------------------------------------------------
logs/
*.log


# -----------------------------------------------------------------------------
# Fichiers système OS
# Créés automatiquement par Windows / macOS — sans valeur pour le projet
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db


# -----------------------------------------------------------------------------
# Éditeurs de code & IDEs
# Préférences locales qui varient d'un développeur à l'autre
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------------------------------------------------------
# Identifiants de test locaux (dépôt public — ne JAMAIS versionner)
# -----------------------------------------------------------------------------
*.local.md
COMPTES-TEST.local.md


# -----------------------------------------------------------------------------
# Divers
# -----------------------------------------------------------------------------
# Dossier de couverture de tests
coverage/

# Fichiers temporaires
*.tmp
*.temp
test-artifacts/

# Vision IA / modeles et datasets locaux
vision-service/models/*.pt
vision-service/models/*.onnx
*.pt
*.onnx
datasets/
runs/
vision-service/.venv/
__pycache__/
.pytest_cache/

# Vision training / YOLO datasets and generated outputs
vision-training/dataset/*
!vision-training/dataset/.gitkeep
!vision-training/dataset/images/
!vision-training/dataset/images/.gitkeep
!vision-training/dataset/images/train/
!vision-training/dataset/images/train/.gitkeep
!vision-training/dataset/images/val/
!vision-training/dataset/images/val/.gitkeep
!vision-training/dataset/images/test/
!vision-training/dataset/images/test/.gitkeep
!vision-training/dataset/labels/
!vision-training/dataset/labels/.gitkeep
!vision-training/dataset/labels/train/
!vision-training/dataset/labels/train/.gitkeep
!vision-training/dataset/labels/val/
!vision-training/dataset/labels/val/.gitkeep
!vision-training/dataset/labels/test/
!vision-training/dataset/labels/test/.gitkeep
vision-training/results/*
!vision-training/results/.gitkeep
vision-training/models/*
!vision-training/models/.gitkeep
