# Configuration de la base de données MySQL
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=marsatrack_db
DB_PORT=3306

# Configuration du serveur
PORT=3001

# Origines autorisées par CORS (liste séparée par des virgules).
CORS_ORIGINS=http://localhost:5173

# Anti brute-force sur /api/auth/login (fenêtre en ms + nombre max d'essais/IP).
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=10

# Sécurité JWT (obligatoire : le serveur doit refuser de démarrer sans secret)
JWT_SECRET=
# Durée de validité du token (le contrôleur applique actuellement 8h).
JWT_EXPIRES_IN=8h

# Microservice Vision IA
VISION_SERVICE_URL=http://localhost:8000
# Résultat simulé de secours : désactivé par défaut. Ne l'activer qu'en démo
# hors ligne — un résultat simulé ne doit jamais être enregistré comme réel.
VISION_FALLBACK_ENABLED=false
VISION_TIMEOUT_MS=180000
